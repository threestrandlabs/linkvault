# Firebase web app config. PLACEHOLDERS ONLY: never put real values in this file.
# Local dev: copy to .env.local (gitignored) and fill in from
# Firebase Console > Project settings > General > Your apps > Web app.
# Production builds get these from GitHub Actions repo secrets (see .github/workflows/deploy.yml).
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional: base URL of the metadata server (server.ts) for local dev only.
# Leave unset for the static GitHub Pages build; it falls back to the on-device category engine.
# VITE_API_BASE=http://localhost:3000

# Server-side only (server.ts). NEVER prefix with VITE_ and never commit a real value.
# GEMINI_API_KEY=
